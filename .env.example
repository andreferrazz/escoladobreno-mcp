# Public origin of this service, no trailing slash. OAuth metadata is built from it.
PUBLIC_URL=https://escoladobreno-mcp.example.com
# Signs client ids, authorization codes and tokens. Rotating it signs every client out.
# Generate with: openssl rand -hex 32
SIGNING_SECRET=
# Output of: pnpm hash-password. This is the password typed on the sign-in page.
ADMIN_PASSWORD_HASH=

# One-click deployments set CONNECTOR_PASSWORD (12+ characters) instead of the three above;
# see the README.

# Login of the app.escoladobreno.com account the tools act on.
BRENO_EMAIL=
BRENO_PASSWORD=

PORT=3000
